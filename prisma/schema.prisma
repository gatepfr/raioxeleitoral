generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidate {
  id                   String            @id @default(uuid())
  sq_candidato         String
  nome_completo        String
  nome_urna            String
  cpf                  String?
  titulo_eleitor       String            @unique
  email_tse            String?
  partido              String
  cargo                String
  uf                   String
  municipio            String
  ue_id                String?
  situacao_candidatura String
  situacao_totalizacao String?
  updatedAt            DateTime          @updatedAt
  ano_ultima_eleicao   Int               @default(2024)
  patrimonio_total     Float             @default(0)
  total_votos          Int               @default(0)
  total_despesas       Float             @default(0)
  assets               CandidateAsset[]
  socials              CandidateSocial[]
  votesByCity          CandidateVote[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CandidateAsset {
  id           String    @id @default(uuid())
  candidate_id String
  tipo_bem     String
  descricao    String
  valor        Float
  candidate    Candidate @relation(fields: [candidate_id], references: [id])
}

model CandidateSocial {
  id           String    @id @default(uuid())
  candidate_id String
  tipo_rede    String
  url          String
  candidate    Candidate @relation(fields: [candidate_id], references: [id])

  @@unique([candidate_id, url])
}

model CandidateVote {
  id           String    @id @default(uuid())
  candidate_id String
  municipio    String
  votos        Int
  candidate    Candidate @relation(fields: [candidate_id], references: [id])

  @@index([candidate_id])
}

model MyCandidate {
  id               String   @id @default(uuid())
  nome             String
  cpf              String?
  email            String?
  telefone         String
  uf               String
  municipio        String
  cargo            String
  origem_indicacao String?
  rede_social      String?
  tipo_origem      String   @default("MANUAL")
  tse_id           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  partido          String?
  lead             Lead?
}

model Lead {
  id                   String        @id @default(uuid())
  status               String        @default("PROSPECT")
  vendedor_responsavel String?
  valor_contrato       Float?
  data_proxima_acao    DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  my_candidate_id      String        @unique
  interactions         Interaction[]
  my_candidate         MyCandidate   @relation(fields: [my_candidate_id], references: [id])
}

model Interaction {
  id            String   @id @default(uuid())
  lead_id       String
  anotacao      String
  tipo_contato  String
  data_registro DateTime @default(now())
  lead          Lead     @relation(fields: [lead_id], references: [id])
}
